# Local defaults. Production Compose sets production/live mode itself.
SPONSORFLOW_ENVIRONMENT=development
SPONSORFLOW_DATABASE_URL=sqlite:///./sponsorflow.db
SPONSORFLOW_STORAGE_PATH=./data
SPONSORFLOW_PROVIDER_MODE=fake
# Keep loopback addresses unless temporary LAN access is required; 0.0.0.0 exposes services on every interface.
SPONSORFLOW_API_HOST=127.0.0.1
SPONSORFLOW_WEB_HOST=127.0.0.1
SPONSORFLOW_TELEGRAM_DAILY_NEW_CONTACT_LIMIT=20
SPONSORFLOW_TELEGRAM_QUOTA_TIMEZONE=UTC
# Retry-stable per-lead pacing within prospect-local Monday-Friday business hours.
SPONSORFLOW_OUTREACH_JITTER_MIN_MINUTES=4
SPONSORFLOW_OUTREACH_JITTER_MAX_MINUTES=28
SPONSORFLOW_CROSS_CHANNEL_GAP_MIN_MINUTES=45
SPONSORFLOW_CROSS_CHANNEL_GAP_MAX_MINUTES=150
SPONSORFLOW_CONVERSATION_REPLY_MIN_SECONDS=35
SPONSORFLOW_CONVERSATION_REPLY_MAX_SECONDS=600

# AI brain. Use fake only for deterministic local tests. Supported real providers are:
# - nvidia_nim: NVIDIA's fixed hosted OpenAI-compatible endpoint with a dedicated API key.
# - vertex_maas: Vertex AI managed open-model OpenAI endpoint. Use auth_mode=gcloud or adc
#   only for local development; production requires metadata credentials from a service account.
# - gateway: loopback/private OpenAI-compatible gateway with a dedicated runtime key.
# - bedrock: AWS Bedrock Runtime with ambient task-role credentials.
SPONSORFLOW_LLM_PROVIDER=fake
SPONSORFLOW_LLM_MODEL=
SPONSORFLOW_LLM_GATEWAY_URL=
SPONSORFLOW_LLM_GATEWAY_PATH=/v1/chat/completions
SPONSORFLOW_LLM_GATEWAY_PROTOCOL=openai
SPONSORFLOW_LLM_API_KEY=
SPONSORFLOW_LLM_BEDROCK_REGION=us-east-1
SPONSORFLOW_LLM_VERTEX_PROJECT_ID=
SPONSORFLOW_LLM_VERTEX_REGION=us-east5
# Leave blank to derive REGION-aiplatform.googleapis.com.
SPONSORFLOW_LLM_VERTEX_ENDPOINT=
SPONSORFLOW_LLM_VERTEX_API_VERSION=v1beta1
SPONSORFLOW_LLM_VERTEX_AUTH_MODE=metadata
# Short-lived explicit tokens are for controlled non-production tests only.
SPONSORFLOW_LLM_VERTEX_ACCESS_TOKEN=
SPONSORFLOW_LLM_VERTEX_TOKEN_TTL_SECONDS=3000
# Never paste an NVIDIA key into chat, source control, logs, or command arguments.
SPONSORFLOW_LLM_NVIDIA_API_KEY=
SPONSORFLOW_LLM_NVIDIA_TOP_P=0.95
SPONSORFLOW_LLM_NVIDIA_THINKING=true
SPONSORFLOW_LLM_NVIDIA_REASONING_EFFORT=high
SPONSORFLOW_LLM_MAX_OUTPUT_TOKENS=1200
SPONSORFLOW_LLM_TIMEOUT_SECONDS=45
SPONSORFLOW_LLM_MAX_RETRIES=2
# Local launcher requires a successful authenticated /v1/models response before startup.
SPONSORFLOW_GATEWAY_READINESS_ATTEMPTS=45
SPONSORFLOW_LLM_MIN_CONFIDENCE=0.72
SPONSORFLOW_LLM_AUTONOMY=guarded_auto
SPONSORFLOW_LLM_GENERATION_STALE_SECONDS=600
SPONSORFLOW_MINIMUM_RESEARCH_CONFIDENCE=0.6

# API-to-API bootstrap controls. Never expose these to browser JavaScript.
SPONSORFLOW_ADMIN_API_KEY=
SPONSORFLOW_OPERATOR_API_KEY=
SPONSORFLOW_VIEWER_API_KEY=
SPONSORFLOW_INBOUND_WEBHOOK_TOKEN=
# Generate a 32-byte URL-safe base64 key once; loss makes stored provider secrets unreadable.
SPONSORFLOW_PROVIDER_ENCRYPTION_KEY=

# Next.js server-only BFF/login configuration.
INTERNAL_API_URL=http://localhost:8000/api/v1
INTERNAL_API_ORIGIN=http://localhost:8000
SPONSORFLOW_WEB_ADMIN_PASSWORD=
SPONSORFLOW_WEB_SESSION_SECRET=
# Enable only when an authoritative reverse proxy overwrites X-Real-IP (the production Caddyfile does).
SPONSORFLOW_TRUST_PROXY=false

# Production Compose bootstrap values.
SPONSORFLOW_DOMAIN=
POSTGRES_PASSWORD=

# Live accounts should normally be entered after login at CRM > Providers.
# Environment values remain available for emergency recovery or task-role deployments.
SPONSORFLOW_SES_REGION=
SPONSORFLOW_SES_SENDER_EMAIL=
SPONSORFLOW_SES_REPLY_TO=
SPONSORFLOW_SES_SNS_TOPIC_ARN=
SPONSORFLOW_TELEGRAM_API_ID=
SPONSORFLOW_TELEGRAM_API_HASH=
SPONSORFLOW_TELEGRAM_SESSION_STRING=
SPONSORFLOW_WHATSAPP_ACCESS_TOKEN=
SPONSORFLOW_WHATSAPP_PHONE_NUMBER_ID=
SPONSORFLOW_WHATSAPP_APP_SECRET=
SPONSORFLOW_WHATSAPP_VERIFY_TOKEN=
SPONSORFLOW_CALCOM_API_KEY=
SPONSORFLOW_CALCOM_EVENT_TYPE_ID=
SPONSORFLOW_CALCOM_WEBHOOK_SECRET=
SPONSORFLOW_TAVILY_API_KEY=
